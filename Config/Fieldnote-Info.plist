<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- xtool supplies CFBundleIdentifier, CFBundleName, CFBundleExecutable,
	     CFBundlePackageType and MinimumOSVersion from Package.swift and xtool.yml,
	     and merges the keys below over them. Do not use $(BUILD_SETTING) syntax
	     here: nothing substitutes it outside Xcode. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en_AU</string>
	<key>CFBundleDisplayName</key>
	<string>Fieldnote</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>FieldnoteGitCommit</key>
	<string>local</string>
	<!-- iPhone only: xtool's packer defaults UIDeviceFamily to [1, 2] (iPhone + iPad)
	     when this key is absent, which pulls in iPad-specific App Store icon
	     requirements Fieldnote doesn't need. -->
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
	<!-- Fieldnote's only network use is the opt-in Apple Maps place lookup, which
	     goes through Apple's own frameworks (exempt encryption). The app has no
	     encryption of its own beyond Apple's CryptoKit for backups. This skips the
	     export-compliance question App Store Connect otherwise asks on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Fieldnote records meetings on this device. Audio, transcripts and summaries never leave the device unless you share them yourself.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Fieldnote can record where a meeting started, as coordinates only. Off by default, and used only while you are recording.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Fieldnote can add action items from a meeting to a Reminders list you choose. Off by default, and asked for only when you use it.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Fieldnote can add a follow-up from a meeting to your calendar. Off by default, and asked for only when you use it.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.publicarray.fieldnotes.processing</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio recording</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.audio</string>
				<string>public.mpeg-4</string>
				<string>com.apple.quicktime-movie</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
