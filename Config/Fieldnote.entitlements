<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets a BGContinuedProcessingTask run Neural Engine inference after the app
	     backgrounds. Without this the summarisation stage dies on backgrounding. -->
	<key>com.apple.developer.background-tasks.continued-processing.inference</key>
	<true/>
	<!-- No continued-processing.gpu: the App ID doesn't grant it. The background task
	     asks for the GPU only when BGTaskScheduler.supportedResources says it can
	     have it, so without the entitlement it runs on the CPU and Neural Engine. -->
	<!-- Raises the memory iOS lets the app use. Preparing and running Qwen3 1.7B
	     needs about 2.4 GB on top of the app; without this, iOS closed the app
	     while preparing it (build 37 log). App ID capability: Increased Memory Limit. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- Deliberately absent: com.apple.security.network.client and
	     com.apple.security.network.server. Fieldnote makes no outbound requests. -->
</dict>
</plist>
