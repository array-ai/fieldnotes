# SwiftPM / xtool
.build/
.swiftpm/configuration/registries.json
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
/xtool
*.ipa

# Vendored CoreML models. Large binaries with their own provenance; fetch them with
# Scripts/vendor-diarization-models.sh rather than committing them.
Resources/DiarizationModels/*
!Resources/DiarizationModels/.gitkeep

# Xcode, if the package is opened there
DerivedData/
xcuserdata/
*.xcuserstate

# macOS
.DS_Store

# Credentials. There should be none in this project, but never commit them.
.netrc
*.mobileprovision
*.p12
*.p8
*.key
*.pem
*.cer

# Photo-manager sidecar notes (e.g. Screenshots/.comments/*.xml)
.comments/
